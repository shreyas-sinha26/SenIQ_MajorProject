# ─── Dependencies ────────────────────────────────────────────
node_modules/
.npm/
.pnp.*

# ─── Secrets / environment ───────────────────────────────────
# Never commit real credentials. .env.example is the tracked template.
.env
.env.local
.env.*.local
*.pem

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server.out.log
server.err.log
boot.log
boot.err.log

# ─── Legacy local SQLite DB (app runs on Postgres now) ───────
# Keep data/congress_sample.json — the smart-money pipeline depends on it.
data/*.db
data/*.db-shm
data/*.db-wal
# Stories removed by the retention job, archived first (services/retention.js).
data/archive/
*.sqlite
*.sqlite3

# ─── Local tooling / editor / IDE ────────────────────────────
.claude/
.vscode/
.idea/
*.swp
*.swo

# ─── OS cruft ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Build / coverage / cache ────────────────────────────────
dist/
build/
coverage/
.cache/
*.tsbuildinfo

# ─── Python (roadmap PDF script) ─────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# local dev workspace
strategy-service/

# ─── Eval run outputs (answers, tool results, judge verdicts) ─
eval/ask/runs/

# Sentiment model training: downloaded data and model weights
training/data/
models/

# Downloaded constituent lists the listed tier is built from (scripts/build_listed_universe.js)
server/data/sources/
