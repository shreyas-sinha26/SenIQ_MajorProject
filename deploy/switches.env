# The hosted copy's feature switches. deploy.sh adds these to the app's settings on every run;
# to change one, edit it here and run deploy.sh again. API keys are not here: they are taken
# from your local .env and kept encrypted in AWS Parameter Store.

# FinBERT reads each new story, inside the app.
FINBERT_CLASSIFY=1
# College project, shown to a professor: on, with NSE's and InvestorGain's terms unsettled.
IPO_WATCH=1
INDIA_SMART_MONEY=1

# Off for the first start; each goes on at Annas's word.
# 1 = the app calls Claude (Ask, the brief, alert explanations, report cards): real spend.
CLAUDE_REPORTS=0
# 1 = alert, report and sign-up emails go out (the SMTP settings from your .env are sent).
ENABLE_EMAIL=0
# 1 = news for the listed names nobody holds (more stories, more Finnhub calls).
INDIA_LISTED_NEWS=0
US_LISTED_NEWS=0

# The model on the home server, later: its Tailscale address, e.g. http://100.x.y.z:11434.
# Empty = no local model; FinBERT's readings stand.
OLLAMA_URL=
